@{
    ViewData["Title"] = "Uluslararası Futbol & Scouting Platformu";
}

<style>
    /* Hero Kartı (Koyu Prestijli Stadyum & Scouting Degradesi) */
    .home-hero-container {
        position: relative;
        background: var(--hero-gradient);
        border: 1px solid var(--hero-card-border);
        border-radius: 32px;
        padding: 4.5rem 3.5rem;
        margin-top: 1.5rem;
        margin-bottom: 3rem;
        overflow: hidden;
        box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.35);
        color: #ffffff;
    }
    .home-hero-container::before {
        content: '';
        position: absolute;
        top: 0; right: 0; width: 50%; height: 100%;
        background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.12) 0%, transparent 70%);
        pointer-events: none;
    }
    .home-hero-container::after {
        content: '';
        position: absolute;
        bottom: -50px; left: 10%; width: 300px; height: 150px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
        pointer-events: none;
    }

    .hero-artwork-card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 28px;
        box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.3);
        padding: 2.5rem 2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hero-artwork-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 42px -4px rgba(56, 189, 248, 0.25);
    }

    .hero-brand-artwork {
        max-width: 340px;
        width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
        filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.15));
        transition: transform 0.3s ease;
    }
    .hero-brand-artwork:hover {
        transform: scale(1.02);
    }

    /* İstatistik Çubuğu */
    .stat-metric-card {
        background: var(--surface-bg);
        border: 1px solid var(--border-soft);
        border-radius: 20px;
        padding: 1.75rem 1.5rem;
        box-shadow: var(--shadow-subtle);
        height: 100%;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .stat-metric-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-card);
        border-color: var(--brand-primary);
    }

    /* Özellik Kartları */
    .feature-layer-card {
        background: var(--surface-bg);
        border: 1px solid var(--border-soft);
        border-radius: 24px;
        padding: 2.25rem 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-subtle);
    }
    .feature-layer-card:hover {
        transform: translateY(-6px);
        border-color: var(--brand-primary);
        box-shadow: var(--shadow-hover);
    }

    .feature-icon-badge {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 1.5rem;
    }

    .hero-filter-pill {
        background: rgba(255, 255, 255, 0.12);
        color: #f8fafc !important;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 6px 14px;
        border-radius: var(--radius-pill);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .hero-filter-pill:hover {
        background: rgba(255, 255, 255, 0.25);
        border-color: #38bdf8;
        color: #ffffff !important;
        transform: translateY(-1px);
    }

    .hero-action-btn {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: var(--radius-pill);
        font-weight: 600;
        padding: 0.65rem 1.4rem;
        transition: all 0.2s ease;
    }
    .hero-action-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: #38bdf8;
        transform: translateY(-1px);
    }
</style>

<div class="container">
    <!-- Hero Bölümü (Koyu Kontrastlı Stadyum Odaklı Banner) -->
    <div class="home-hero-container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); font-size: 0.85rem; font-weight: 700;">
                    <i class="bi bi-radar"></i> ULUSLARARASI SCOUTING & TRANSFER PAZARI
                </div>
                
                <h1 class="display-5 fw-bold mb-3 text-white" style="line-height: 1.2;">
                    Geleceğin Yıldızlarını Keşfedin, <br>
                    <span style="color: #38bdf8;">Piyasa Dinamiklerini</span> Yönetin.
                </h1>
                
                <p class="fs-5 mb-4" style="color: #cbd5e1; font-weight: 400; max-width: 580px;">
                    InterFullMarkt; yapay zekâ fiyat projeksiyonları, 6 eksenli yetenek radarları ve gerçek zamanlı transfer bütçeleriyle küresel futbol dünyasını tek çatı altında toplar.
                </p>

                <!-- Profesyonel Scout Arama Konsolu (Omnibox) -->
                <form method="get" action="/Players" class="mb-3" style="max-width: 640px;">
                    <div class="scout-search-wrap">
                        <div class="scout-search-icon-box">
                            <i class="bi bi-search"></i>
                        </div>
                        <input type="text" name="search" class="scout-search-input" 
                               placeholder="Oyuncu, kulüp veya mevki arayın" autocomplete="off">
                        <button type="submit" class="scout-search-btn">
                            <span>Keşfet</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </form>

                <!-- Hızlı Keşif Hapları -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                    <small class="text-white-50 fw-semibold me-1"><i class="bi bi-lightning-charge-fill text-warning"></i> Hızlı Filtre:</small>
                    <a href="/Players?wonderkids=true" class="hero-filter-pill">
                        ⭐ Wonderkids (&le;21)
                    </a>
                    <a href="/Players?minMarketValue=50000000" class="hero-filter-pill">
                        💎 &euro;50M+ Yıldızlar
                    </a>
                    <a href="/Players?search=Süper%20Lig" class="hero-filter-pill">
                        🇹🇷 Süper Lig
                    </a>
                    <a href="/Players?search=Premier%20League" class="hero-filter-pill">
                        🏴󠁧󠁢󠁥󠁮󠁧󠁿 Premier League
                    </a>
                </div>

                <!-- Hızlı Konsol Yönlendirme Butonları -->
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Players" asp-action="Index" class="btn hero-action-btn">
                        <i class="bi bi-radar me-1 text-info"></i> Scout Konsolu
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn hero-action-btn">
                        <i class="bi bi-graph-up me-1 text-info"></i> Pazar Analizi
                    </a>
                    <a asp-controller="Clubs" asp-action="Index" class="btn hero-action-btn">
                        <i class="bi bi-shield-check me-1 text-info"></i> Kulüpler Kataloğu
                    </a>
                </div>
            </div>

            <!-- Sağ Taraf: Kart İçine Alınmış Logo & Resmî Rozet -->
            <div class="col-lg-5 text-center">
                <div class="hero-artwork-card">
                    <img src="/images/logo.png" alt="InterFullMarkt Platform Logo" class="hero-brand-artwork mb-3">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill" style="background: rgba(15, 76, 110, 0.08); color: #0f4c6e; font-size: 0.85rem; font-weight: 600;">
                        <i class="bi bi-patch-check-fill text-success"></i> Resmî Uluslararası Futbol Ekosistemi
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Canlı Metrik Çubuğu -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="stat-metric-card text-center">
                <small class="text-subtle text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Yetenek Radarı</small>
                <div class="h2 fw-bold text-heading mt-2 mb-1">6 Eksenli</div>
                <small class="text-body fw-medium">FIFA & FM Standartları</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-metric-card text-center">
                <small class="text-subtle text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Genç Yetenekler</small>
                <div class="h2 fw-bold mt-2 mb-1" style="color: var(--brand-accent);">Wonderkids</div>
                <small class="text-body fw-medium">&le;21 Yaş Gelişim Potansiyeli</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-metric-card text-center">
                <small class="text-subtle text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Fiyat Tahmini</small>
                <div class="h2 fw-bold mt-2 mb-1" style="color: var(--brand-primary);">Gemini AI</div>
                <small class="text-body fw-medium">12 Aylık Değer Projeksiyonu</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-metric-card text-center">
                <small class="text-subtle text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Transfer Motoru</small>
                <div class="h2 fw-bold text-success mt-2 mb-1">Canlı Bütçe</div>
                <small class="text-body fw-medium">Domain Driven Transferler</small>
            </div>
        </div>
    </div>

    <!-- 3 Sütunlu Temiz Özellik Kartları -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4 col-md-6">
            <div class="feature-layer-card">
                <div class="feature-icon-badge" style="background: var(--brand-primary-soft); color: var(--brand-primary);">
                    <i class="bi bi-radar"></i>
                </div>
                <h4 class="fw-bold text-heading mb-2">Akıllı Scouting Konsolu</h4>
                <p class="text-body small flex-grow-1 mb-4">
                    Mevki, dominant ayak, scout reytingi ve wonderkid filtreleriyle kulübünüzün geleceğini inşa edecek yetenekleri anında filtreleyin.
                </p>
                <a asp-controller="Players" asp-action="Index" class="btn btn-soft align-self-start">
                    Konsolu Aç <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="feature-layer-card">
                <div class="feature-icon-badge" style="background: var(--brand-accent-soft); color: var(--brand-accent-text);">
                    <i class="bi bi-robot"></i>
                </div>
                <h4 class="fw-bold text-heading mb-2">Yapay Zekâ Piyasa Analitiği</h4>
                <p class="text-body small flex-grow-1 mb-4">
                    Google Gemini entegrasyonu sayesinde oyuncuların gelecek dönem değer değişimlerini, taktiksel güçlü yönlerini ve arketip eşleşmelerini keşfedin.
                </p>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-soft align-self-start">
                    Pazar Panosu <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="feature-layer-card">
                <div class="feature-icon-badge" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                    <i class="bi bi-newspaper"></i>
                </div>
                <h4 class="fw-bold text-heading mb-2">Haber & Transfer Bülteni</h4>
                <p class="text-body small flex-grow-1 mb-4">
                    Uluslararası futbol arenasındaki flaş sözleşmeler, transfer iddiaları ve lig puanı gelişmelerini doğrulanmış kaynaklardan takip edin.
                </p>
                <a asp-controller="News" asp-action="Index" class="btn btn-soft align-self-start">
                    Bülteni Oku <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
