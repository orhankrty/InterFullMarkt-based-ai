<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="InterFullMarkt - Uluslararası Futbol ve Scouting Platformu. Yapay zekâ destekli oyuncu değerleme, scouting filtreleri ve yetenek radarları." />
    <meta name="keywords" content="futbol, scout, scouting, futbolcu, transfer, piyasa değeri, kulüpler, ligler, wonderkids" />
    <meta property="og:title" content="InterFullMarkt - Uluslararası Futbol & Scouting Platformu" />
    <meta property="og:description" content="Geleceğin yıldızlarını keşfedin, yapay zekâ fiyat projeksiyonları ve yetenek radarlarını yönetin." />
    <meta property="og:image" content="/images/logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>@ViewData["Title"] - InterFullMarkt</title>

    <!-- FOUC Önleyici Erken Tema Yükleyici -->
    <script>
        (function () {
            try {
                const storedTheme = localStorage.getItem('theme');
                if (storedTheme) {
                    document.documentElement.setAttribute('data-bs-theme', storedTheme);
                } else {
                    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    document.documentElement.setAttribute('data-bs-theme', prefersDark ? 'dark' : 'light');
                }
            } catch (e) {}
        })();
    </script>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- CSS Kütüphaneleri -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Global Tasarım Sistemi & Dual Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InterFullMarkt.WebUI.styles.css" asp-append-version="true" />

    <style>
        /* Navbar & Koyu Kontrast Stilleri */
        .site-navbar { 
            background: var(--navbar-bg) !important;
            border-bottom: 1px solid var(--navbar-border) !important;
            padding: 0.65rem 0;
            transition: background-color 0.3s ease, border-color 0.3s ease;
            box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.35);
        }

        .navbar-brand {
            padding: 0;
            display: inline-flex;
            align-items: center;
        }

        .brand-logo-wrapper {
            background: rgba(255, 255, 255, 0.94);
            padding: 5px 14px;
            border-radius: var(--radius-pill);
            display: inline-flex;
            align-items: center;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
            transition: all 0.25s ease;
        }
        .brand-logo-wrapper:hover {
            background: #ffffff;
            transform: scale(1.02);
            box-shadow: 0 6px 18px rgba(56, 189, 248, 0.3);
        }

        .brand-logo-img {
            height: 44px;
            width: auto;
            max-width: 190px;
            object-fit: contain;
            display: block;
            image-rendering: -webkit-optimize-contrast;
        }

        .nav-link {
            font-weight: 600;
            font-size: 0.92rem;
            color: #cbd5e1 !important;
            transition: all 0.2s ease;
            padding: 0.55rem 0.9rem !important;
            border-radius: var(--radius-md);
            display: inline-flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

        .nav-link:hover {
            color: #38bdf8 !important;
            background-color: rgba(56, 189, 248, 0.1);
        }

        .nav-link.active {
            color: #ffffff !important;
            background-color: rgba(56, 189, 248, 0.18);
            border: 1px solid rgba(56, 189, 248, 0.3);
        }

        .nav-link i {
            font-size: 1.05rem;
            color: #94a3b8;
            transition: color 0.2s ease;
        }
        .nav-link:hover i, .nav-link.active i {
            color: #38bdf8;
        }

        .watchlist-nav-badge {
            background-color: var(--brand-accent);
            color: #ffffff;
            font-weight: 800;
            font-size: 0.7rem;
            padding: 2px 7px;
            border-radius: var(--radius-pill);
        }

        .navbar-action-btn {
            background: rgba(255, 255, 255, 0.08);
            color: #f8fafc !important;
            border: 1px solid rgba(255, 255, 255, 0.15);
            font-weight: 600;
            border-radius: var(--radius-pill);
            transition: all 0.2s ease;
        }
        .navbar-action-btn:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.3);
            color: #38bdf8 !important;
            transform: translateY(-1px);
        }

        /* Ortak Omnibox / Scout Arama Konsolu Stilleri */
        .scout-search-wrap {
            display: flex;
            align-items: center;
            background: var(--surface-bg);
            border: 1.5px solid var(--border-soft);
            border-radius: var(--radius-pill);
            padding: 6px 8px 6px 14px;
            box-shadow: var(--shadow-card);
            transition: all 0.25s ease;
        }
        .scout-search-wrap:focus-within {
            border-color: var(--brand-primary);
            box-shadow: 0 12px 30px -4px rgba(15, 76, 110, 0.25), 0 0 0 4px rgba(15, 76, 110, 0.15);
        }
        .scout-search-icon-box {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--brand-primary-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-primary);
            font-size: 1.15rem;
            flex-shrink: 0;
            margin-right: 10px;
        }
        .scout-search-input {
            flex: 1;
            border: none !important;
            background: transparent !important;
            outline: none !important;
            box-shadow: none !important;
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-heading) !important;
            padding: 0.5rem 0;
        }
        .scout-search-input::placeholder {
            color: var(--text-subtle);
            font-weight: 400;
        }
        .scout-search-btn {
            background: var(--brand-primary);
            color: #ffffff !important;
            border: none;
            border-radius: var(--radius-pill);
            padding: 0.65rem 1.6rem;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(15, 76, 110, 0.3);
            transition: all 0.2s ease;
            flex-shrink: 0;
            text-decoration: none;
        }
        .scout-search-btn:hover {
            background: var(--brand-primary-hover);
            transform: translateY(-1px);
        }

        /* Footer Koyu Stil */
        .site-footer {
            background-color: var(--footer-bg);
            border-top: 1px solid var(--footer-border);
            color: #cbd5e1;
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }
        .site-footer a {
            color: #94a3b8;
            transition: color 0.2s ease;
        }
        .site-footer a:hover {
            color: #38bdf8 !important;
        }
    </style>
</head>
<body>
    
    <nav class="navbar navbar-expand-xl site-navbar sticky-top">
        <div class="container-xl">
            <!-- Sol: Yüksek Kontrastlı Logo Kapsayıcısı -->
            <a class="navbar-brand py-0 me-3 me-xl-4" asp-controller="Home" asp-action="Index" title="InterFullMarkt Anasayfa">
                <span class="brand-logo-wrapper">
                    <img src="/images/logo.png" alt="InterFullMarkt" class="brand-logo-img" />
                </span>
            </a>
            
            <!-- Mobil Menü Aç/Kapat Butonu -->
            <button class="navbar-toggler border-0 p-2 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Menüyü Aç">
                <i class="bi bi-list fs-2 text-white"></i>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Orta: Menü Linkleri -->
                <ul class="navbar-nav mx-auto align-items-center gap-1 my-2 my-xl-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> <span>Anasayfa</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Players" ? "active" : "")" asp-controller="Players" asp-action="Index">
                            <i class="bi bi-radar"></i> <span>Oyuncular</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clubs" ? "active" : "")" asp-controller="Clubs" asp-action="Index">
                            <i class="bi bi-shield-check"></i> <span>Kulüpler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link position-relative @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Scout" ? "active" : "")" asp-controller="Scout" asp-action="Watchlist">
                            <i class="bi bi-bookmark-star"></i> <span>Scout Listesi</span>
                            <span id="watchlistBadge" class="watchlist-nav-badge ms-1" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-graph-up"></i> <span>Pazar Analizi</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "News" ? "active" : "")" asp-controller="News" asp-action="Index">
                            <i class="bi bi-newspaper"></i> <span>Haberler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Store" ? "active" : "")" asp-controller="Store" asp-action="Index">
                            <i class="bi bi-bag"></i> <span>Mağaza</span>
                        </a>
                    </li>
                </ul>

                <!-- Sağ: Hızlı Aksiyonlar & Tema Değiştirici & Profil & Sepet -->
                <div class="d-flex align-items-center justify-content-end gap-2 my-2 my-xl-0">
                    <!-- Tema Değiştirme Butonu (Güneş / Ay) -->
                    <button id="themeToggleBtn" type="button" class="btn btn-theme-toggle" title="Gece / Gündüz Modu" aria-label="Gece / Gündüz Modu">
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                        <i class="bi bi-sun-fill theme-icon-light d-none"></i>
                    </button>

                    <!-- Sepet Butonu -->
                    <a href="javascript:void(0)" class="btn navbar-action-btn position-relative d-inline-flex align-items-center justify-content-center" style="width: 44px; height: 44px; border-radius: 50%;" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer" title="Sepetim">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">0</span>
                    </a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <a class="btn navbar-action-btn dropdown-toggle d-flex align-items-center gap-2 py-2 px-3 rounded-pill" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5" style="color: #38bdf8;"></i>
                                <span class="fw-semibold">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-2" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Account" asp-action="Index"><i class="bi bi-person-badge text-primary"></i> Hesabım</a></li>
                                <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Scout" asp-action="Watchlist"><i class="bi bi-bookmark-star text-warning"></i> Scout Listem</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock text-danger"></i> Yönetim Paneli</a></li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li><a class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-brand-primary d-inline-flex align-items-center gap-2 py-2 px-4 rounded-pill fw-semibold text-nowrap" asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> <span>Giriş Yap</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main role="main" style="min-height: 85vh;" class="py-2">
        @RenderBody()
    </main>

    <footer class="site-footer py-5 mt-5">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-5 text-md-start">
                    <div class="mb-3">
                        <span class="brand-logo-wrapper" style="padding: 4px 12px;">
                            <img src="/images/logo.png" alt="InterFullMarkt" style="height: 36px; width: auto;" />
                        </span>
                    </div>
                    <p class="small mb-1 text-light fw-medium">International Football Market & AI-Assisted Scouting Platform.</p>
                    <small class="text-secondary">
                        BTK Akademi & Samsun Teknopark iş birliğiyle, <strong>Prof. Dr. Zafer Cömert</strong> rehberliğinde geliştirilmiştir.
                    </small>
                </div>
                <div class="col-md-3 text-center">
                    <div class="d-flex justify-content-center gap-3 fs-5">
                        <a href="javascript:void(0)" class="hover-primary" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="javascript:void(0)" class="hover-primary" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="javascript:void(0)" class="hover-primary" title="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="javascript:void(0)" class="hover-primary" title="GitHub"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="col-md-4 text-md-end text-secondary small">
                    <p class="mb-0 text-white fw-bold">&copy; @DateTime.Now.Year - InterFullMarkt Ekosistemi</p>
                    <div class="fw-medium text-light">Clean Architecture & ASP.NET Core 10</div>
                    <div style="font-size: 0.75rem;">Mimar: Hüseyin Orhan Kırtay</div>
                </div>
            </div>
        </div>
    </footer>

    <partial name="_CartDrawer" />
    <partial name="_AIChatbot" />
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tema Değiştirici Motoru (Dual Theme Switcher)
        (function() {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const darkIcon = toggleBtn ? toggleBtn.querySelector('.theme-icon-dark') : null;
            const lightIcon = toggleBtn ? toggleBtn.querySelector('.theme-icon-light') : null;

            function syncThemeIcons(theme) {
                if (!darkIcon || !lightIcon) return;
                if (theme === 'dark') {
                    darkIcon.classList.add('d-none');
                    lightIcon.classList.remove('d-none');
                } else {
                    lightIcon.classList.add('d-none');
                    darkIcon.classList.remove('d-none');
                }
            }

            const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
            syncThemeIcons(currentTheme);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    const activeTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
                    const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-bs-theme', newTheme);
                    localStorage.setItem('theme', newTheme);
                    syncThemeIcons(newTheme);
                    
                    // Grafik ve diğer bileşenleri bilgilendir
                    window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: newTheme } }));
                });
            }
        })();

        // Scout Watchlist Sayacı
        async function updateWatchlistBadge() {
            try {
                const res = await fetch('/Scout/GetWatchlistCount');
                const data = await res.json();
                const badge = document.getElementById('watchlistBadge');
                if (badge) {
                    badge.innerText = data.count;
                    badge.style.display = data.count > 0 ? 'inline-block' : 'none';
                }
            } catch {}
        }
        document.addEventListener('DOMContentLoaded', updateWatchlistBadge);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>