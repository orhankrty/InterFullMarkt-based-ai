<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InterFullMarkt Yönetim Paneli</title>

    <!-- FOUC Önleyici Erken Tema Yükleyici -->
    <script>
        (function () {
            try {
                const storedTheme = localStorage.getItem('theme');
                if (storedTheme) {
                    document.documentElement.setAttribute('data-bs-theme', storedTheme);
                } else {
                    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    document.documentElement.setAttribute('data-bs-theme', prefersDark ? 'dark' : 'light');
                }
            } catch (e) {}
        })();
    </script>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- CSS Kütüphaneleri -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Global Tasarım Sistemi & Dual Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="admin-layout-wrapper">
        <!-- SOL: Admin Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <a href="/Admin" class="d-flex align-items-center gap-2 text-decoration-none">
                    <span class="brand-logo-wrapper" style="padding: 4px 10px; background: #ffffff;">
                        <img src="/images/logo.png" alt="InterFullMarkt" style="height: 28px; width: auto;" />
                    </span>
                    <span class="badge bg-primary rounded-pill px-2 py-1 text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Admin</span>
                </a>
                <button class="btn btn-sm btn-link text-light d-lg-none p-0" id="closeSidebarBtn" type="button">
                    <i class="bi bi-x-lg fs-5"></i>
                </button>
            </div>

            <div class="admin-sidebar-nav">
                <div class="admin-nav-section-title">Genel & Futbol</div>
                <a href="/Admin" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Genel Bakış</span>
                </a>
                <a href="/Admin/Players" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Player") == true ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Futbolcular</span>
                </a>
                <a href="/Admin/Teams" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Team") == true ? "active" : "")">
                    <i class="bi bi-shield-shaded"></i>
                    <span>Kulüpler & Takımlar</span>
                </a>

                <div class="admin-nav-section-title">E-Ticaret & Mağaza</div>
                <a href="/Admin/Orders" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Order") == true ? "active" : "")">
                    <i class="bi bi-bag-check-fill"></i>
                    <span>Sipariş Yönetimi</span>
                </a>
                <a href="/Admin/Products" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Product") == true ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>Mağaza Ürünleri</span>
                </a>

                <div class="admin-nav-section-title">Sistem & Denetim</div>
                <a href="/Admin/Users" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("User") == true ? "active" : "")">
                    <i class="bi bi-person-gear"></i>
                    <span>Kullanıcılar & Roller</span>
                </a>
                <a href="/Admin/Transfers" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Transfer") == true ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Transfer Audit</span>
                </a>
            </div>

            <!-- Alt Araçlar & Profil -->
            <div class="admin-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                        </div>
                        <div class="lh-1">
                            <div class="fw-bold text-white small">@User.Identity?.Name</div>
                            <small class="text-secondary" style="font-size: 0.72rem;">Sistem Yöneticisi</small>
                        </div>
                    </div>
                    <button id="themeToggleBtn" type="button" class="btn btn-theme-toggle" title="Gece / Gündüz Modu" aria-label="Gece / Gündüz Modu" style="width: 36px; height: 36px; font-size: 1rem;">
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                        <i class="bi bi-sun-fill theme-icon-light d-none"></i>
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <a href="/" class="btn btn-sm btn-outline-light rounded-pill flex-grow-1" style="font-size: 0.8rem;">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Siteye Dön
                    </a>
                    <a href="/Auth/Logout" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Çıkış Yap">
                        <i class="bi bi-power"></i>
                    </a>
                </div>
            </div>
        </aside>

        <!-- SAĞ: Ana Admin Alanı -->
        <div class="admin-main-container">
            <!-- Üst Bar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="openSidebarBtn" type="button">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb admin-breadcrumb">
                                <li class="breadcrumb-item"><a href="/Admin">Yönetim</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                        <h4 class="fw-bold text-heading mb-0 mt-1" style="font-size: 1.25rem;">@ViewData["Title"]</h4>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge badge-soft-success px-3 py-2 rounded-pill d-none d-md-inline-flex align-items-center gap-2">
                        <span class="spinner-grow spinner-grow-sm text-success" style="width: 8px; height: 8px;" role="status"></span>
                        <span class="fw-semibold">Sistem Çevrimiçi</span>
                    </span>

                    <!-- Hızlı Eylem Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-brand-primary btn-sm rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-plus-lg"></i>
                            <span class="d-none d-sm-inline">Hızlı Ekle</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-2">
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="/Admin/Players/Create"><i class="bi bi-person-plus text-primary"></i> Yeni Futbolcu Ekle</a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="/Admin/Teams/Create"><i class="bi bi-shield-plus text-success"></i> Yeni Kulüp Ekle</a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="/Admin/Products/Create"><i class="bi bi-box-seam text-warning"></i> Yeni Mağaza Ürünü Ekle</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Gövde İçeriği -->
            <main class="p-4 p-md-5 flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                        <div>
                            <strong>Başarılı!</strong> @TempData["Success"]
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                        <div>
                            <strong>Hata!</strong> @TempData["Error"]
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Evrensel Silme Onay Modalı -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-body p-4 text-center">
                    <div class="stat-widget-icon mx-auto mb-3" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; width: 64px; height: 64px; border-radius: 50%;">
                        <i class="bi bi-trash3-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-heading mb-2" id="deleteModalTitle">Silme Onayı</h5>
                    <p class="text-subtle mb-4" id="deleteModalMessage">Bu kaydı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-soft rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmDeleteBtn">Evet, Sil</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Temel JS Scriptleri -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Tema & Sidebar JS Motoru -->
    <script>
        // Tema Değiştirici
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const darkIcon = document.querySelector('.theme-icon-dark');
        const lightIcon = document.querySelector('.theme-icon-light');

        function updateIcons(theme) {
            if (theme === 'dark') {
                if (darkIcon) darkIcon.classList.add('d-none');
                if (lightIcon) lightIcon.classList.remove('d-none');
            } else {
                if (darkIcon) darkIcon.classList.remove('d-none');
                if (lightIcon) lightIcon.classList.add('d-none');
            }
        }

        const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
        updateIcons(currentTheme);

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', function () {
                const active = document.documentElement.getAttribute('data-bs-theme');
                const target = active === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', target);
                localStorage.setItem('theme', target);
                updateIcons(target);
            });
        }

        // Mobil Sidebar Aç/Kapa
        const adminSidebar = document.getElementById('adminSidebar');
        const openSidebarBtn = document.getElementById('openSidebarBtn');
        const closeSidebarBtn = document.getElementById('closeSidebarBtn');

        if (openSidebarBtn && adminSidebar) {
            openSidebarBtn.addEventListener('click', () => adminSidebar.classList.add('show'));
        }
        if (closeSidebarBtn && adminSidebar) {
            closeSidebarBtn.addEventListener('click', () => adminSidebar.classList.remove('show'));
        }

        // Evrensel Silme Modalı Yardımcısı
        let targetDeleteUrl = '';
        const deleteModalEl = document.getElementById('deleteConfirmModal');
        const deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;

        function promptDelete(url, title, message) {
            targetDeleteUrl = url;
            if (title) document.getElementById('deleteModalTitle').textContent = title;
            if (message) document.getElementById('deleteModalMessage').textContent = message;
            if (deleteModal) deleteModal.show();
        }

        document.getElementById('confirmDeleteBtn')?.addEventListener('click', function () {
            if (!targetDeleteUrl) return;
            fetch(targetDeleteUrl, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Silme işlemi gerçekleştirilemedi.');
                    }
                })
                .catch(err => {
                    alert('Hata oluştu: ' + err);
                });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
