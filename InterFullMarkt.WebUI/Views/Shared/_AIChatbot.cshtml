<style>
    :root, [data-bs-theme="light"] {
        --chat-widget-bg: rgba(255, 255, 255, 0.88);
        --chat-widget-border: rgba(15, 23, 42, 0.08);
        --chat-header-gradient: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        --chat-user-bg: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        --chat-user-text: #ffffff;
        --chat-ai-bg: #f8fafc;
        --chat-ai-border: rgba(15, 23, 42, 0.06);
        --chat-ai-text: #0f172a;
        --chat-input-bg: #ffffff;
        --chat-input-border: #cbd5e1;
        --chat-chip-bg: #f1f5f9;
        --chat-chip-border: #e2e8f0;
        --chat-chip-text: #0369a1;
        --chat-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18), 0 0 1px 1px rgba(0, 0, 0, 0.05);
    }

    [data-bs-theme="dark"] {
        --chat-widget-bg: rgba(15, 23, 42, 0.88);
        --chat-widget-border: rgba(255, 255, 255, 0.12);
        --chat-header-gradient: linear-gradient(135deg, #0284c7 0%, #075985 100%);
        --chat-user-bg: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        --chat-user-text: #ffffff;
        --chat-ai-bg: #1e293b;
        --chat-ai-border: rgba(255, 255, 255, 0.08);
        --chat-ai-text: #f1f5f9;
        --chat-input-bg: #0f172a;
        --chat-input-border: rgba(255, 255, 255, 0.15);
        --chat-chip-bg: rgba(2, 132, 199, 0.15);
        --chat-chip-border: rgba(56, 189, 248, 0.25);
        --chat-chip-text: #38bdf8;
        --chat-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.65), 0 0 1px 1px rgba(255, 255, 255, 0.1);
    }

    #ai-chat-widget {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font-family: inherit;
    }

    /* Floating Action Button */
    .chat-toggle-btn {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0284c7, #38bdf8);
        color: white;
        border: none;
        box-shadow: 0 10px 25px rgba(2, 132, 199, 0.4);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
    }

    .chat-toggle-btn:hover {
        transform: scale(1.08) translateY(-2px);
        box-shadow: 0 14px 30px rgba(2, 132, 199, 0.5);
    }

    .chat-toggle-btn .pulse-indicator {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 14px;
        height: 14px;
        background: #10b981;
        border: 2px solid white;
        border-radius: 50%;
    }

    /* Chat Window Container */
    .chat-window {
        width: 400px;
        max-width: calc(100vw - 32px);
        height: 600px;
        max-height: calc(100vh - 120px);
        background: var(--chat-widget-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--chat-widget-border);
        border-radius: 24px;
        box-shadow: var(--chat-shadow);
        margin-bottom: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        opacity: 0;
        transform: translateY(20px) scale(0.96);
        pointer-events: none;
    }

    .chat-window.open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: all;
    }

    /* Chat Header */
    .chat-header {
        background: var(--chat-header-gradient);
        color: white;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
    }

    .chat-header .header-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-header .avatar-icon {
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(8px);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .chat-header .header-title {
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.2;
    }

    .chat-header .header-subtitle {
        font-size: 0.75rem;
        opacity: 0.9;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .chat-header .status-dot {
        width: 7px;
        height: 7px;
        background: #34d399;
        border-radius: 50%;
        display: inline-block;
    }

    .chat-header .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-header .action-btn {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
    }

    .chat-header .action-btn:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    /* Quick Prompt Chips */
    .chat-chips-container {
        padding: 10px 16px 4px;
        display: flex;
        gap: 6px;
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: none;
        border-bottom: 1px solid var(--chat-ai-border);
    }

    .chat-chips-container::-webkit-scrollbar {
        display: none;
    }

    .prompt-chip {
        background: var(--chat-chip-bg);
        border: 1px solid var(--chat-chip-border);
        color: var(--chat-chip-text);
        font-size: 0.78rem;
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .prompt-chip:hover {
        transform: translateY(-1px);
        filter: brightness(1.08);
    }

    /* Chat Messages Body */
    .chat-body {
        flex: 1;
        padding: 18px 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .chat-body::-webkit-scrollbar {
        width: 5px;
    }
    .chat-body::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.3);
        border-radius: 10px;
    }

    /* Message Bubbles */
    .msg-wrapper {
        display: flex;
        flex-direction: column;
        max-width: 86%;
        animation: chatFadeIn 0.25s ease-out;
    }

    .msg-wrapper.user {
        align-self: flex-end;
        align-items: flex-end;
    }

    .msg-wrapper.ai {
        align-self: flex-start;
        align-items: flex-start;
    }

    .msg-bubble {
        padding: 12px 16px;
        border-radius: 18px;
        font-size: 0.92rem;
        line-height: 1.5;
        word-wrap: break-word;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        position: relative;
    }

    .msg-wrapper.user .msg-bubble {
        background: var(--chat-user-bg);
        color: var(--chat-user-text);
        border-bottom-right-radius: 4px;
    }

    .msg-wrapper.ai .msg-bubble {
        background: var(--chat-ai-bg);
        color: var(--chat-ai-text);
        border: 1px solid var(--chat-ai-border);
        border-bottom-left-radius: 4px;
    }

    .msg-bubble p:last-child {
        margin-bottom: 0;
    }

    .msg-bubble ul, .msg-bubble ol {
        margin-bottom: 6px;
        padding-left: 20px;
    }

    .msg-bubble strong {
        font-weight: 600;
    }

    .msg-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
        padding: 0 4px;
        font-size: 0.72rem;
        opacity: 0.65;
    }

    .copy-msg-btn {
        background: none;
        border: none;
        color: inherit;
        padding: 0;
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

    .copy-msg-btn:hover {
        opacity: 1;
    }

    /* Typing Indicator */
    .typing-indicator {
        display: none;
        align-self: flex-start;
        background: var(--chat-ai-bg);
        border: 1px solid var(--chat-ai-border);
        padding: 12px 16px;
        border-radius: 18px;
        border-bottom-left-radius: 4px;
        gap: 5px;
        align-items: center;
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        background: #0284c7;
        border-radius: 50%;
        animation: typingBounce 1.4s infinite ease-in-out;
    }

    .typing-dot:nth-child(1) { animation-delay: 0s; }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }

    /* Footer Input Area */
    .chat-footer {
        padding: 12px 16px;
        background: var(--chat-widget-bg);
        border-top: 1px solid var(--chat-widget-border);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-input {
        flex: 1;
        border: 1px solid var(--chat-input-border);
        background: var(--chat-input-bg);
        color: var(--chat-ai-text);
        border-radius: 20px;
        padding: 10px 16px;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .chat-input:focus {
        border-color: #0284c7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
    }

    .chat-send-btn {
        background: linear-gradient(135deg, #0284c7, #38bdf8);
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
        flex-shrink: 0;
    }

    .chat-send-btn:hover {
        transform: scale(1.06);
        filter: brightness(1.1);
    }

    .chat-send-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @@keyframes chatFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes typingBounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }
</style>

<div id="ai-chat-widget">
    <!-- Chat Window -->
    <div class="chat-window d-none" id="chatWindow" role="dialog" aria-label="InterFullMarkt AI Scout Asistanı">
        <!-- Header -->
        <div class="chat-header">
            <div class="header-info">
                <div class="avatar-icon">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <div class="header-title">InterFullMarkt AI Scout</div>
                    <div class="header-subtitle">
                        <span class="status-dot"></span>
                        <span id="chatStatusText">Çevrimiçi • Futbol & Scout Uzmanı</span>
                    </div>
                </div>
            </div>
            <div class="header-actions">
                <button class="action-btn" onclick="clearChatHistory()" title="Sohbeti Temizle" aria-label="Sohbeti Temizle">
                    <i class="bi bi-trash3" style="font-size: 0.85rem;"></i>
                </button>
                <button class="action-btn" onclick="toggleChat()" title="Kapat" aria-label="Kapat">
                    <i class="bi bi-x-lg" style="font-size: 0.85rem;"></i>
                </button>
            </div>
        </div>

        <!-- Quick Prompt Chips -->
        <div class="chat-chips-container" id="chatChipsContainer">
            <button class="prompt-chip" onclick="sendQuickPrompt('En değerli 5 oyuncu kim?')">
                ⚡ En Değerliler
            </button>
            <button class="prompt-chip" onclick="sendQuickPrompt('Arda Güler hakkında scout raporu ver')">
                🔍 Arda Güler
            </button>
            <button class="prompt-chip" onclick="sendQuickPrompt('Genç yetenek (wonderkid) öner')">
                ⭐ Wonderkid Öner
            </button>
            <button class="prompt-chip" onclick="sendQuickPrompt('Mağazadaki popüler ürünler neler?')">
                🛍️ Mağaza Ürünleri
            </button>
        </div>

        <!-- Messages Body -->
        <div class="chat-body" id="chatBody">
            <!-- Initial AI Greeting -->
            <div class="msg-wrapper ai" id="initialGreeting">
                <div class="msg-bubble">
                    Merhaba! Ben <strong>InterFullMarkt AI Scout</strong> asistanınızım. 👋<br><br>
                    Futbolcuların piyasa değerleri, transfer olasılıkları, kulüp analizleri veya mağazamızdaki ürünler hakkında bana her şeyi sorabilirsiniz!
                </div>
                <div class="msg-footer">
                    <span>InterFullMarkt AI</span>
                </div>
            </div>

            <!-- Typing Indicator -->
            <div class="typing-indicator" id="typingIndicator">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        </div>

        <!-- Footer Input -->
        <div class="chat-footer">
            <input type="text" id="chatInput" class="chat-input" placeholder="Futbol veya transfer sorusu sorun..." onkeypress="handleChatKeyPress(event)" />
            <button class="chat-send-btn" id="chatSendBtn" onclick="handleSendClick()" title="Gönder" aria-label="Gönder">
                <i class="bi bi-send-fill" style="font-size: 0.95rem;"></i>
            </button>
        </div>
    </div>

    <!-- Floating Toggle Button -->
    <button class="chat-toggle-btn" id="chatToggleBtn" onclick="toggleChat()" title="InterFullMarkt AI Scout ile Sohbet Et" aria-label="Chatbotu Aç/Kapat">
        <i class="bi bi-robot"></i>
        <span class="pulse-indicator"></span>
    </button>
</div>

<script>
    (function() {
        const chatWindow = document.getElementById('chatWindow');
        const chatBody = document.getElementById('chatBody');
        const chatInput = document.getElementById('chatInput');
        const typingIndicator = document.getElementById('typingIndicator');
        const chatSendBtn = document.getElementById('chatSendBtn');

        // Oturum bazlı konuşma geçmişi (Multi-turn memory)
        let conversationHistory = [];

        try {
            const saved = sessionStorage.getItem('interfullmarkt_chat_history');
            if (saved) {
                conversationHistory = JSON.parse(saved);
            }
        } catch {}

        window.toggleChat = function() {
            if (chatWindow.classList.contains('d-none')) {
                chatWindow.classList.remove('d-none');
                setTimeout(() => {
                    chatWindow.classList.add('open');
                    chatInput.focus();
                }, 10);
            } else {
                chatWindow.classList.remove('open');
                setTimeout(() => {
                    chatWindow.classList.add('d-none');
                }, 300);
            }
        };

        window.handleChatKeyPress = function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                handleSendClick();
            }
        };

        window.sendQuickPrompt = function(promptText) {
            chatInput.value = promptText;
            handleSendClick();
        };

        window.clearChatHistory = function() {
            conversationHistory = [];
            try { sessionStorage.removeItem('interfullmarkt_chat_history'); } catch {}
            
            // Başlangıç selamı harici tüm mesajları temizle
            const messages = chatBody.querySelectorAll('.msg-wrapper:not(#initialGreeting)');
            messages.forEach(m => m.remove());
        };

        window.handleSendClick = async function() {
            const text = chatInput.value.trim();
            if (!text) return;

            // Input temizle ve butonu pasifleştir
            chatInput.value = '';
            chatSendBtn.disabled = true;

            // Kullanıcı mesajını arayüze ekle
            appendMessageUI(text, 'user');
            scrollToBottom();
            showTyping();

            try {
                // İstek DTO'su (Geçmişle beraber)
                const payload = {
                    message: text,
                    history: conversationHistory
                };

                const response = await fetch('/Chatbot/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                hideTyping();
                chatSendBtn.disabled = false;

                if (response.ok && data.response) {
                    // Kullanıcı ve AI mesajını hafızaya kaydet
                    conversationHistory.push({ role: 'user', text: text });
                    conversationHistory.push({ role: 'model', text: data.response });

                    try {
                        sessionStorage.setItem('interfullmarkt_chat_history', JSON.stringify(conversationHistory.slice(-10)));
                    } catch {}

                    appendMessageUI(data.response, 'ai', data.model);
                } else {
                    appendMessageUI("Üzgünüm, bir hata oluştu: " + (data.error || "Sunucudan yanıt alınamadı."), 'ai');
                }
            } catch (error) {
                hideTyping();
                chatSendBtn.disabled = false;
                appendMessageUI("Sunucuya bağlanılamadı. Lütfen internet bağlantınızı kontrol ediniz.", 'ai');
                console.error('Chat Error:', error);
            }

            scrollToBottom();
            chatInput.focus();
        };

        // Hafif Markdown Biçimlendirici (Bold, İtalik, Listeler, Paragraflar)
        function formatMarkdown(text) {
            if (!text) return '';
            
            let html = text
                // HTML kaçışları
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                // Kalın: **metin**
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                // İtalik: *metin*
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                // Ayırıcı çizgi: ---
                .replace(/---/g, '<hr class="my-2 border-secondary opacity-25">');

            // Satır bazlı liste kontrolü
            const lines = html.split('\n');
            let formattedLines = [];
            let inList = false;

            lines.forEach(line => {
                const trimmed = line.trim();
                if (trimmed.startsWith('* ') || trimmed.startsWith('- ')) {
                    if (!inList) {
                        formattedLines.push('<ul class="mb-2 ps-3">');
                        inList = true;
                    }
                    formattedLines.push(`<li>${trimmed.substring(2)}</li>`);
                } else {
                    if (inList) {
                        formattedLines.push('</ul>');
                        inList = false;
                    }
                    if (trimmed.length > 0) {
                        formattedLines.push(`<p class="mb-1">${line}</p>`);
                    }
                }
            });

            if (inList) formattedLines.push('</ul>');

            return formattedLines.join('');
        }

        function appendMessageUI(text, sender, modelName) {
            const wrapper = document.createElement('div');
            wrapper.className = `msg-wrapper ${sender}`;

            const bubble = document.createElement('div');
            bubble.className = 'msg-bubble';

            if (sender === 'ai') {
                bubble.innerHTML = formatMarkdown(text);
            } else {
                bubble.textContent = text;
            }

            const footer = document.createElement('div');
            footer.className = 'msg-footer';

            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            if (sender === 'ai') {
                footer.innerHTML = `
                    <span>InterFullMarkt AI</span>
                    <span>•</span>
                    <span>${timeStr}</span>
                    <button class="copy-msg-btn ms-1" onclick="copyToClipboard(this)" title="Yanıtı Kopyala">
                        <i class="bi bi-clipboard"></i>
                    </button>
                `;
            } else {
                footer.innerHTML = `<span>${timeStr}</span>`;
            }

            wrapper.appendChild(bubble);
            wrapper.appendChild(footer);

            chatBody.insertBefore(wrapper, typingIndicator);
        }

        window.copyToClipboard = function(btn) {
            const bubble = btn.closest('.msg-wrapper').querySelector('.msg-bubble');
            if (bubble) {
                navigator.clipboard.writeText(bubble.innerText);
                const icon = btn.querySelector('i');
                if (icon) {
                    icon.className = 'bi bi-check2 text-success';
                    setTimeout(() => icon.className = 'bi bi-clipboard', 2000);
                }
            }
        };

        function scrollToBottom() {
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function showTyping() {
            typingIndicator.style.display = 'flex';
            scrollToBottom();
        }

        function hideTyping() {
            typingIndicator.style.display = 'none';
        }
    })();
</script>
