<div class="list-group list-group-flush rounded-4 overflow-hidden border shadow-sm account-nav-group" style="border-color: var(--border-soft) !important;">
    <a href="/Account" class="list-group-item list-group-item-action d-flex align-items-center py-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
        <i class="bi bi-speedometer2 fs-5 me-3"></i>
        <span>Hesap Özeti</span>
    </a>
    <a href="/Account/Profile" class="list-group-item list-group-item-action d-flex align-items-center py-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")">
