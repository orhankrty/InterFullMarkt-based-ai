@model InterFullMarkt.Domain.Entities.User
@{
    ViewData["Title"] = "Profil Bilgileri";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(15, 76, 110, 0.08); color: var(--brand-primary); font-size: 0.825rem; font-weight: 700;">
                <i class="bi bi-person-gear"></i> KULLANICI AYARLARI
            </div>
            <h1 class="display-6 fw-bold mb-1 text-heading">Profil Bilgileri</h1>
            <p class="text-body small mb-0 fw-medium">Kişisel bilgilerinizi, iletişim tercihlerinizi ve hesap güvenliğinizi güncelleyin.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="card border p-3 shadow-sm mb-4" style="border-color: var(--border-soft) !important; border-radius: 22px;">
                <partial name="_AccountSidebar" />
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card shadow-sm p-4 mb-4" style="border: 1px solid var(--border-soft); border-radius: 22px;">
                <h4 class="fw-bold text-heading mb-3">Kişisel Bilgiler</h4>
                <p class="text-subtle small mb-4">Sistem üzerinde görünen adınız, soyadınız ve teslimat iletişim numaranız.</p>
                
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 bg-success bg-opacity-10 text-success border-success border-opacity-25 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }

                <form asp-action="Profile" method="post" class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label text-heading small fw-bold">Kullanıcı Adı</label>
                        <input type="text" class="form-control" style="background-color: var(--surface-subtle) !important;" value="@Model.Username" readonly disabled>
                        <small class="text-subtle" style="font-size: 0.775rem;">Kullanıcı adı sistem güvenliği nedeniyle değiştirilemez.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-heading small fw-bold">E-Posta Adresi</label>
                        <input type="email" class="form-control" style="background-color: var(--surface-subtle) !important;" value="@Model.Email" readonly disabled>
                        <small class="text-subtle" style="font-size: 0.775rem;">Kayıtlı resmî e-posta adresiniz.</small>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label text-heading small fw-bold">Ad</label>
                        <input type="text" name="firstName" value="@Model.FirstName" class="form-control" placeholder="Adınız" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-heading small fw-bold">Soyad</label>
                        <input type="text" name="lastName" value="@Model.LastName" class="form-control" placeholder="Soyadınız" required>
                    </div>
                    
                    <div class="col-md-12">
                        <label class="form-label text-heading small fw-bold">Telefon Numarası</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-subtle fw-bold" style="border-color: var(--border-soft);">+90</span>
                            <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="form-control" placeholder="5xx xxx xxxx">
                        </div>
                        <small class="text-subtle" style="font-size: 0.775rem;">Sipariş kargo ve teslimat bildirimleri için kullanılır.</small>
                    </div>

                    <div class="col-12 pt-2">
                        <button type="submit" class="btn btn-brand-primary px-5 py-2">
                            <i class="bi bi-check2 me-1"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>

            <!-- Security Box -->
            <div class="card shadow-sm p-4" style="border: 1px solid var(--border-soft); border-radius: 22px;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-shield-lock-fill text-danger fs-4"></i>
                    <h5 class="text-heading fw-bold mb-0">Hesap Güvenliği</h5>
                </div>
                <p class="text-subtle small mb-3">Hesap parolanızı değiştirebilir veya ek güvenlik doğrulama adımlarını yapılandırabilirsiniz.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-soft text-danger" onclick="alert('Şifre yenileme bağlantısı e-posta adresinize gönderildi.')">
                        <i class="bi bi-key me-1"></i> Şifre Değiştir
                    </button>
                    <button type="button" class="btn btn-sm btn-soft" onclick="alert('İki faktörlü kimlik doğrulama bir sonraki güncellemede kullanıma açılacaktır.')">
                        <i class="bi bi-shield-check me-1"></i> İki Faktörlü Doğrulama
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
