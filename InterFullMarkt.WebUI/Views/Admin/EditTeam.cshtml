@model InterFullMarkt.Application.DTOs.UpdateClubDto
@{
    ViewData["Title"] = "Kulübü Düzenle";
    var leagues = ViewBag.Leagues as List<InterFullMarkt.Application.Features.Leagues.Queries.GetAllLeagues.LeagueDto> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-success fs-5"></i>
                    <h5 class="fw-bold text-heading mb-0">Kulüp Bilgilerini Güncelle</h5>
                </div>
                <a href="/Admin/Teams" class="btn btn-sm btn-soft rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Listeye Dön
                </a>
            </div>

            <div class="admin-card-body p-4 p-md-5">
                <form method="post" action="/Admin/Teams/Edit/@Model.Id">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Currency" value="EUR" />

                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold text-heading small">Kulüp Tam Adı <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-heading small">Kısa İsim <span class="text-danger">*</span></label>
                            <input asp-for="ShortName" class="form-control" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Stadyum Adı <span class="text-danger">*</span></label>
                            <input asp-for="StadiumName" class="form-control" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Kuruluş Yılı <span class="text-danger">*</span></label>
                            <input asp-for="FoundingYear" type="number" class="form-control" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Kulüp Renkleri <span class="text-danger">*</span></label>
                            <input asp-for="Colors" class="form-control" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Lig</label>
                            <select asp-for="LeagueId" class="form-select" style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                                <option value="">Lig Seçin...</option>
                                @foreach (var league in leagues)
                                {
                                    <option value="@league.Id" selected="@(league.Id == Model.LeagueId)">@league.Name (@league.CountryName)</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-heading small">Logo URL</label>
                            <input asp-for="LogoUrl" class="form-control" placeholder="https://..." style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Bütçe Değeri (€) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: var(--surface-subtle); border-color: var(--border-soft); color: var(--text-heading);">€</span>
                                <input asp-for="BudgetAmount" type="number" class="form-control" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                        <a href="/Admin/Teams" class="btn btn-soft rounded-pill px-4">Vazgeç</a>
                        <button type="submit" class="btn btn-brand-primary rounded-pill px-5">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
