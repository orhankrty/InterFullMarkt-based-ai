@model InterFullMarkt.Application.DTOs.CreateClubDto
@{
    ViewData["Title"] = "Yeni Kulüp Ekle";
    var leagues = ViewBag.Leagues as List<InterFullMarkt.Application.Features.Leagues.Queries.GetAllLeagues.LeagueDto> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-plus text-success fs-5"></i>
                    <h5 class="fw-bold text-heading mb-0">Yeni Kulüp Kayıt Formu</h5>
                </div>
                <a href="/Admin/Teams" class="btn btn-sm btn-soft rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Listeye Dön
                </a>
            </div>

            <div class="admin-card-body p-4 p-md-5">
                <form method="post" action="/Admin/Teams/Create">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold text-heading small">Kulüp Tam Adı <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Galatasaray Spor Kulübü" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-heading small">Kısa İsim (3-4 Harf) <span class="text-danger">*</span></label>
                            <input asp-for="ShortName" class="form-control" placeholder="Örn: GS" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Stadyum Adı <span class="text-danger">*</span></label>
                            <input asp-for="StadiumName" class="form-control" placeholder="Örn: Rams Park" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Kuruluş Yılı <span class="text-danger">*</span></label>
                            <input asp-for="FoundingYear" type="number" min="1800" max="2026" class="form-control" placeholder="Örn: 1905" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Kulüp Renkleri <span class="text-danger">*</span></label>
                            <input asp-for="Colors" class="form-control" placeholder="Örn: Sarı - Kırmızı" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Bağlı Olduğu Lig <span class="text-danger">*</span></label>
                            <select asp-for="LeagueId" class="form-select" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                                <option value="">Lig Seçin...</option>
                                @foreach (var league in leagues)
                                {
                                    <option value="@league.Id">@league.Name (@league.CountryName)</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-heading small">Kulüp Logosu URL</label>
                            <input asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.png" style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                            <div class="form-text text-subtle small">Kulüp logosu için harici web bağlantısı veya yerel dosya yolu giriniz.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-heading small">Başlangıç Bütçesi (€) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: var(--surface-subtle); border-color: var(--border-soft); color: var(--text-heading);">€</span>
                                <input asp-for="InitialBudget" type="number" step="100000" class="form-control" placeholder="Örn: 50000000" required style="background: var(--surface-bg); border-color: var(--border-soft); color: var(--text-heading);">
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                        <a href="/Admin/Teams" class="btn btn-soft rounded-pill px-4">İptal</a>
                        <button type="submit" class="btn btn-brand-primary rounded-pill px-5">Kulübü Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
