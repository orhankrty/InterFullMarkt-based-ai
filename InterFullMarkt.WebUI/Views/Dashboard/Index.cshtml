@model InterFullMarkt.Application.Features.Dashboard.Queries.GetDashboardResult
@{
    ViewData["Title"] = "Piyasa & Scouting Yönetim Panosu";
}

<style>
    .stat-card-custom {
        background: var(--surface-bg);
        border: 1px solid var(--border-soft);
        border-radius: 20px;
        padding: 1.75rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-subtle);
    }
    .stat-card-custom:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-card);
        border-color: var(--brand-primary);
    }
    .stat-icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .dashboard-panel {
        background: var(--surface-bg);
        border: 1px solid var(--border-soft);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: var(--shadow-subtle);
    }
    .player-row {
        transition: background 0.2s ease;
    }
    .player-row:hover {
        background: var(--table-hover-bg);
    }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: var(--brand-primary-soft); color: var(--brand-primary); font-size: 0.825rem; font-weight: 700;">
                <i class="bi bi-activity"></i> CANLI PİYASA RADARI
            </div>
            <h1 class="display-6 fw-bold mb-1 text-heading">Futbol Piyasası & Scouting Panosu</h1>
            <p class="text-body small mb-0 fw-medium">Uluslararası oyuncu değerleri, wonderkid potansiyelleri ve lig finansal analitiği.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Players" asp-action="Index" class="btn btn-brand-primary">
                <i class="bi bi-search me-1"></i> Oyuncu Keşfet
            </a>
            <a asp-controller="Clubs" asp-action="Index" class="btn btn-soft">
                <i class="bi bi-shield-check me-1"></i> Kulüpler
            </a>
        </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card-custom h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="background: var(--brand-primary-soft); color: var(--brand-primary);">
                        <i class="bi bi-currency-euro"></i>
                    </div>
                    <div>
                        <div class="text-subtle small fw-bold text-uppercase">Toplam Piyasa Hacmi</div>
                        <h2 class="fw-bold mb-0 text-heading">@Model.TotalMarketValue</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-custom h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="background: var(--brand-accent-soft); color: var(--brand-accent);">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <div class="text-subtle small fw-bold text-uppercase">Kayıtlı Oyuncu</div>
                        <h2 class="fw-bold mb-0 text-heading">@Model.TotalPlayers</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-custom h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                        <i class="bi bi-shield-shaded"></i>
                    </div>
                    <div>
                        <div class="text-subtle small fw-bold text-uppercase">Aktif Kulüp</div>
                        <h2 class="fw-bold mb-0 text-heading">@Model.TotalClubs</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content: Top Players & Value Gainers -->
    <div class="row g-4 mb-4">
        <!-- Top 5 Highest Market Value -->
        <div class="col-lg-6">
            <div class="dashboard-panel h-100">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--border-subtle) !important;">
                    <h5 class="fw-bold mb-0 text-heading">
                        <i class="bi bi-trophy-fill text-warning me-2"></i> En Değerli Oyuncular
                    </h5>
                    <span class="badge border" style="background: var(--surface-subtle); color: var(--text-subtle); border-color: var(--border-soft) !important;">Top 5</span>
                </div>
                <div class="p-0">
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr class="text-subtle small">
                                    <th class="ps-4">Oyuncu</th>
                                    <th>Kulüp</th>
                                    <th>Mevki</th>
                                    <th class="text-end pe-4">Değer</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in Model.TopPlayers)
                                {
                                    <tr class="player-row">
                                        <td class="ps-4">
                                            <a href="@Url.Action("Details", "Players", new { id = player.PlayerId })" class="text-decoration-none text-heading fw-bold">
                                                <span class="me-1">@player.NationalityFlag</span> @player.FullName
                                            </a>
                                        </td>
                                        <td class="text-subtle small">@player.ClubName</td>
                                        <td><span class="badge rounded-pill border" style="background: var(--surface-subtle); color: var(--text-heading); border-color: var(--border-soft) !important;">@player.Position</span></td>
                                        <td class="text-end pe-4 fw-bold" style="color: var(--brand-primary);">@player.MarketValue</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Value Gainers (Wonderkid / Growth Potential) -->
        <div class="col-lg-6">
            <div class="dashboard-panel h-100">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--border-subtle) !important;">
                    <h5 class="fw-bold mb-0 text-heading">
                        <i class="bi bi-graph-up-arrow text-success me-2"></i> Değer Artış Potansiyeli
                    </h5>
                    <span class="badge border" style="background: var(--surface-subtle); color: var(--brand-accent); border-color: var(--border-soft) !important;">Wonderkids & Yükselenler</span>
                </div>
                <div class="p-0">
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr class="text-subtle small">
                                    <th class="ps-4">Oyuncu</th>
                                    <th>Kulüp</th>
                                    <th>Potansiyel</th>
                                    <th class="text-end pe-4">Tahmini Artış</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in Model.ValueGainers)
                                {
                                    <tr class="player-row">
                                        <td class="ps-4">
                                            <a href="@Url.Action("Details", "Players", new { id = player.PlayerId })" class="text-decoration-none text-heading fw-bold">
                                                @player.FullName
                                            </a>
                                        </td>
                                        <td class="text-subtle small">@player.ClubName</td>
                                        <td>
                                            <span class="badge rounded-pill @(player.PercentageGain >= 15 ? "bg-success" : "bg-info")">
                                                +@player.PercentageGain.ToString("F0")%
                                            </span>
                                        </td>
                                        <td class="text-end pe-4 text-success fw-bold">@player.ValueIncrease</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- League Financial Overview -->
    <div class="row">
        <div class="col-12">
            <div class="dashboard-panel">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--border-subtle) !important;">
                    <h5 class="fw-bold mb-0 text-heading">
                        <i class="bi bi-globe-europe-africa text-primary me-2"></i> Lig Analizi & Finansal Dağılım
                    </h5>
                </div>
                <div class="p-0">
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr class="text-subtle small">
                                    <th class="ps-4">Lig Adı</th>
                                    <th>Ülke</th>
                                    <th>Kulüp Sayısı</th>
                                    <th>Oyuncu Sayısı</th>
                                    <th>Ortalama Oyuncu Değeri</th>
                                    <th class="text-end pe-4">Toplam Lig Hacmi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var league in Model.LeagueStats)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-heading">@league.LeagueName</td>
                                        <td>@league.CountryFlag @league.Country</td>
                                        <td>@league.TotalClubs Kulüp</td>
                                        <td>@league.TotalPlayers Oyuncu</td>
                                        <td class="text-subtle">@league.AveragePlayerValue</td>
                                        <td class="text-end pe-4 fw-bold" style="color: var(--brand-primary);">@league.TotalSquadValue</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
